# ============================================================
# Dockerfile สำหรับนำขึ้นเว็บสาธารณะ (container เดียว)
# ============================================================
#
# ใช้กับผู้ให้บริการที่รันได้ container เดียวและเปิดพอร์ตเดียว เช่น Render.com
# จึงต้องรวม API กับหน้าเว็บไว้ด้วยกัน แล้วให้ FastAPI เสิร์ฟทั้งสองอย่าง
#
# **ห้ามใช้ไฟล์นี้แทน Dockerfile หลัก** — งานส่งอาจารย์ต้องใช้
# docker-compose.yml ที่แยก 4 service ตามโจทย์ ซึ่งใช้ Dockerfile ตัวหลัก
#
# ต้องตั้งค่าเหล่านี้ที่ผู้ให้บริการ (ห้ามเขียนลงไฟล์)
#   DATABASE_URL   สตริงเชื่อมต่อ PostgreSQL จากภายนอก เช่นจาก Neon
#   JWT_SECRET     ข้อความลับยาว ๆ สำหรับเซ็น token
#
# วิธีทดสอบในเครื่องก่อนอัป:
#   docker build -f Dockerfile.hf -t bookvice-web .
#   docker run --rm -p 7860:7860 -e DATABASE_URL="..." bookvice-web

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# คัดลอกทั้งฝั่งเซิร์ฟเวอร์และหน้าเว็บ เพราะ container นี้ต้องเสิร์ฟเองทั้งคู่
COPY ./app ./app
COPY ./web ./web

# Space รันด้วยผู้ใช้ที่ไม่ใช่ root และเขียนได้เฉพาะบางที่
# จึงเก็บรูปที่อัปโหลดไว้ใน /tmp แทน /app/uploads
#
# ข้อแลกเปลี่ยน: รูปหายทุกครั้งที่ Space รีสตาร์ตหรือ build ใหม่
# ถ้าต้องการเก็บถาวรต้องซื้อ Persistent Storage แล้วชี้ UPLOAD_DIR ไปที่ /data
ENV SERVE_WEB=true \
    UPLOAD_DIR=/tmp/uploads \
    PORT=7860

RUN mkdir -p /tmp/uploads && chmod 777 /tmp/uploads

EXPOSE 7860

# ต้องเขียนแบบ shell form (ไม่ใช่ JSON array) เพื่อให้ ${PORT} ถูกแทนค่าจริงตอนรัน
#
# เหตุผล: ผู้ให้บริการแต่ละเจ้ากำหนดพอร์ตไม่เหมือนกันและส่งมาทาง environment variable
#   Render        ส่ง PORT มาให้เอง ต้องฟังตามนั้น ไม่งั้นระบบจะถือว่าแอปไม่ตอบสนอง
#   ทดสอบในเครื่อง ไม่ได้ตั้ง PORT จึงใช้ค่าสำรอง 7860
#
# ถ้าเขียนเป็น JSON array ตัว ${PORT} จะถูกส่งเป็นข้อความตรง ๆ แล้ว uvicorn จะพัง
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-7860}
